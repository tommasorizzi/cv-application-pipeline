        "period": {
          "$ref": "#/$defs/Claim"
        },
        "details": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Details",
          "type": "array"
        }
      },
      "required": [
        "degree",
        "institution",
        "period",
        "details"
      ],
      "title": "Education",
      "type": "object"
    },
    "Experience": {
      "additionalProperties": false,
      "properties": {
