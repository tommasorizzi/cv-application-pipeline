          "type": "string"
        }
      },
      "required": [
        "salutation",
        "paragraphs",
        "signoff"
      ],
      "title": "Letter",
      "type": "object"
    },
    "Paragraph": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 2200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "fact_ids"
      ],
      "title": "Paragraph",
      "type": "object"
    },
    "SkillGroup": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 45,
          "title": "Category",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "category",
        "items"
      ],
      "title": "SkillGroup",
      "type": "object"
    }
