        "headline": {
          "$ref": "#/$defs/Claim"
        },
        "summary": {
          "$ref": "#/$defs/Claim"
        },
        "section_order": {
          "items": {
            "enum": [
              "experience",
              "education",
              "skills",
              "publications",
              "conferences",
              "languages",
              "projects"
            ],
            "type": "string"
          },
          "title": "Section Order",
          "type": "array"
        },
        "experience": {
          "items": {
            "$ref": "#/$defs/Experience"
          },
          "minItems": 1,
          "title": "Experience",
          "type": "array"
        },
        "education": {
          "items": {
            "$ref": "#/$defs/Education"
          },
          "minItems": 1,
          "title": "Education",
          "type": "array"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/SkillGroup"
          },
          "minItems": 1,
          "title": "Skills",
          "type": "array"
        },
        "projects": {
          "items": {
            "$ref": "#/$defs/Bullet"
          },
          "title": "Projects",
          "type": "array"
        },
        "publications": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Publications",
          "type": "array"
        },
        "conferences": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Conferences",
          "type": "array"
        },
        "languages": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Languages",
          "type": "array"
        }
      },
      "required": [
        "header",
        "headline",
        "summary",
        "section_order",
        "experience",
        "education",
        "skills",
        "projects",
        "publications",
        "conferences",
        "languages"
      ],
      "title": "CV",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 1800,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "type": "string"
