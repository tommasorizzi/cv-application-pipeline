    "Bullet": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 65,
          "title": "Label",
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/Claim"
        }
      },
      "required": [
        "label",
        "claim"
      ],
      "title": "Bullet",
      "type": "object"
    },
    "CV": {
      "additionalProperties": false,
      "properties": {
        "header": {
          "$ref": "#/$defs/Header"
