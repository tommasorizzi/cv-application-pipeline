        "email": {
          "$ref": "#/$defs/Claim"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Links",
          "type": "array"
        }
      },
      "required": [
        "name",
        "location",
        "email",
        "links"
      ],
      "title": "Header",
      "type": "object"
    },
    "Letter": {
      "additionalProperties": false,
      "properties": {
        "salutation": {
          "title": "Salutation",
          "type": "string"
        },
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/Paragraph"
          },
          "maxItems": 6,
          "minItems": 3,
          "title": "Paragraphs",
          "type": "array"
