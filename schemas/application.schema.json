  "additionalProperties": false,
  "properties": {
    "cv": {
      "$ref": "#/$defs/CV"
    },
    "letter": {
      "$ref": "#/$defs/Letter"
    },
    "change_summary": {
      "items": {
        "type": "string"
      },
      "title": "Change Summary",
      "type": "array"
    }
  },
  "required": [
    "cv",
    "letter",
    "change_summary"
  ],
  "title": "Bundle",
  "type": "object"
}
