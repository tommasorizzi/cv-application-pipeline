{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "minLength": 3,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "omissions": {
          "items": {
            "type": "string"
          },
          "title": "Omissions",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "fact_ids",
        "omissions"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "identity",
            "education",
            "experience",
            "project",
            "skill",
            "publication",
            "conference",
            "language",
            "motivation"
          ],
          "title": "Category",
          "type": "string"
        },
        "text": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "status": {
          "enum": [
            "explicit",
            "derived_safe",
            "uncertain",
            "conflicting"
          ],
          "title": "Status",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "review_note": {
          "title": "Review Note",
          "type": "string"
        }
      },
      "required": [
        "id",
        "category",
        "text",
        "status",
        "sources",
        "review_note"
      ],
      "title": "Fact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "minItems": 1,
      "title": "Facts",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/Coverage"
      },
      "title": "Coverage",
      "type": "array"
    },
    "voice_guide": {
      "title": "Voice Guide",
      "type": "string"
    },
    "conflicts": {
      "items": {
        "type": "string"
      },
      "title": "Conflicts",
      "type": "array"
    }
  },
  "required": [
    "facts",
    "coverage",
    "voice_guide",
    "conflicts"
  ],
  "title": "Profile",
  "type": "object"
}
